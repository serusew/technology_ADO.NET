using Microsoft.Data.SqlClient;
using System.Data;

string connectionString =
    "Server=localhost;Database=coffee_shop;Trusted_Connection=True;TrustServerCertificate=True;";

using var connection = new SqlConnection(connectionString);
connection.Open();
Console.WriteLine("Подключение установлено.\n");

// 1
int productId = 3;
string selectSql = @"SELECT id, name, price 
                     FROM products 
                     WHERE id = @id;";
using (var cmd = new SqlCommand(selectSql, connection))
{
    cmd.Parameters.Add("@id", SqlDbType.Int).Value = productId;
    using var reader = cmd.ExecuteReader();
    while (reader.Read())
    {
        Console.WriteLine($"Товар: {reader["id"]} — {reader["name"]} — {reader["price"]}");
    }
}

// 2
int updateId = 3;
decimal newPrice = 220.00m;
string updateSql = @"UPDATE products 
                     SET price = @price 
                     WHERE id = @id;";
using (var cmd = new SqlCommand(updateSql, connection))
{
    cmd.Parameters.Add("@price", SqlDbType.Decimal).Value = newPrice;
    cmd.Parameters.Add("@id", SqlDbType.Int).Value = updateId;
    Console.WriteLine($"Обновлено строк: {cmd.ExecuteNonQuery()}");
}

string fullName = "иришка чики пики";
string phone = "+7-900-123-45-67";
string? email = null;   
string insertSql = @"INSERT INTO customers (full_name, phone, email) 
                     VALUES (@full_name, @phone, @email);";
using (var cmd = new SqlCommand(insertSql, connection))
{
    cmd.Parameters.Add("@full_name", SqlDbType.NVarChar, 150).Value = fullName;
    cmd.Parameters.Add("@phone", SqlDbType.NVarChar, 20).Value = phone;
    cmd.Parameters.Add("@email", SqlDbType.NVarChar, 150).Value =
        (object?)email ?? DBNull.Value;
    Console.WriteLine($"Добавлено клиентов: {cmd.ExecuteNonQuery()}");
}

int customerId = 16;
string deleteSql = @"DELETE FROM customers 
                     WHERE id = @id;";
using (var cmd = new SqlCommand(deleteSql, connection))
{
    cmd.Parameters.Add("@id", SqlDbType.Int).Value = customerId;
    Console.WriteLine($"Удалено строк: {cmd.ExecuteNonQuery()}");
}

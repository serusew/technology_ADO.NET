IF OBJECT_ID('college.trg_Students_AverageGradeAudit', 'TR') IS NOT NULL
    DROP TRIGGER college.trg_Students_AverageGradeAudit;
GO

CREATE TRIGGER college.trg_Students_AverageGradeAudit
ON college.students
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO college.student_changes
        (student_id, old_average_grade, new_average_grade,
         old_age, new_age, change_date)
    SELECT
        i.id,
        d.average_grade,
        i.average_grade,
        d.age,
        i.age,
        GETDATE()
    FROM inserted i
    INNER JOIN deleted d ON d.id = i.id
    WHERE ISNULL(i.average_grade, -1) <> ISNULL(d.average_grade, -1)
       OR ISNULL(i.age, -1)            <> ISNULL(d.age, -1);
END;
GO


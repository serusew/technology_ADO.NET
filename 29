IF OBJECT_ID('college.trg_Students_ValidateGrade', 'TR') IS NOT NULL
    DROP TRIGGER college.trg_Students_ValidateGrade;
GO

CREATE TRIGGER college.trg_Students_ValidateGrade
ON college.students
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (
        SELECT 1
        FROM inserted
        WHERE average_grade < 0 OR average_grade > 5
    )
    BEGIN
        THROW 50001, N'Средний балл должен быть в диапазоне от 0 до 5.', 1;
    END
END;
GO


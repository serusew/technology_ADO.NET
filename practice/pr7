using Microsoft.Data.SqlClient;
using Microsoft.Extensions.Configuration;

// 3.
IConfiguration configuration = new ConfigurationBuilder()
    .SetBasePath(AppContext.BaseDirectory)
    .AddJsonFile("appsettings.json", optional: false)
    .AddJsonFile("appsettings.Development.json", optional: true) 
    .AddEnvironmentVariables()
    .Build();

string connectionString = configuration.GetConnectionString("CoffeeShop")
    ?? throw new InvalidOperationException("Строка подключения 'CoffeeShop' не найдена.");

// 6
string title = configuration["Application:Title"] ?? "Приложение";
bool showPrices = bool.TryParse(configuration["Application:ShowPrices"], out bool sp) && sp;

Console.WriteLine(title);
Console.WriteLine(new string('=', Math.Max(title.Length, 10)));

// 7 меню 
while (true)
{
    Console.WriteLine();
    Console.WriteLine("1. Проверить подключение к базе");
    Console.WriteLine("2. Показать количество товаров, клиентов и заказов");
    Console.WriteLine("3. Вывести список доступных товаров");
    Console.WriteLine("4. Найти товары по части названия");
    Console.WriteLine("5. Показать настройки приложения");
    Console.WriteLine("6. Выход");
    Console.Write("Выбор: ");

    string? choice = Console.ReadLine();
    Console.WriteLine();

    try
    {
        switch (choice)
        {
            case "1":
                await CheckConnectionAsync(connectionString);
                break;
            case "2":
                await ShowStatisticsAsync(connectionString);
                break;
            case "3":
                await ShowProductsAsync(connectionString, showPrices);
                break;
            case "4":
                Console.Write("Введите часть названия: ");
                string search = Console.ReadLine() ?? string.Empty;
                await SearchProductsAsync(connectionString, search, showPrices);
                break;
            case "5":
                Console.WriteLine($"Название приложения: {title}");
                Console.WriteLine($"Показывать цены: {showPrices}");
                break;
            case "6":
                return;
            default:
                Console.WriteLine("Неизвестный пункт меню.");
                break;
        }
    }
    catch (SqlException ex)
    {
        Console.WriteLine($"Ошибка подключения к SQL Server: {ex.Message}");
    }
    catch (InvalidOperationException ex)
    {
        Console.WriteLine($"Ошибка конфигурации: {ex.Message}");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Ошибка: {ex.Message}");
    }
}


// 4
static async Task CheckConnectionAsync(string connectionString)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand("SELECT DB_NAME()", connection);
    string databaseName = (string)(await command.ExecuteScalarAsync())!;

    Console.WriteLine($"Подключено к базе: {databaseName}");
}

// 5
static async Task ShowStatisticsAsync(string connectionString)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    int products  = await ScalarIntAsync(connection, "SELECT COUNT(*) FROM products");
    int customers = await ScalarIntAsync(connection, "SELECT COUNT(*) FROM customers");
    int orders    = await ScalarIntAsync(connection, "SELECT COUNT(*) FROM orders");

    Console.WriteLine("Статистика кофейни");
    Console.WriteLine($"Товаров:  {products}");
    Console.WriteLine($"Клиентов: {customers}");
    Console.WriteLine($"Заказов:  {orders}");
}

static async Task<int> ScalarIntAsync(SqlConnection connection, string sql)
{
    using SqlCommand command = new SqlCommand(sql, connection);
    return Convert.ToInt32(await command.ExecuteScalarAsync());
}

// 6
static async Task ShowProductsAsync(string connectionString, bool showPrices)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand(
        "SELECT name, price FROM products ORDER BY name", connection);

    using SqlDataReader reader = await command.ExecuteReaderAsync();

    bool any = false;
    while (await reader.ReadAsync())
    {
        any = true;
        string name  = reader.GetString(0);
        decimal price = reader.GetDecimal(1);

        Console.WriteLine(showPrices
            ? $"{name} — {price:C}"
            : name);
    }

    if (!any)
        Console.WriteLine("Товары не найдены.");
}

// 7
static async Task SearchProductsAsync(string connectionString, string search, bool showPrices)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand(
        "SELECT name, price FROM products WHERE name LIKE '%' + @search + '%' ORDER BY name",
        connection);
    command.Parameters.AddWithValue("@search", search);

    using SqlDataReader reader = await command.ExecuteReaderAsync();

    bool any = false;
    while (await reader.ReadAsync())
    {
        any = true;
        string name  = reader.GetString(0);
        decimal price = reader.GetDecimal(1);

        Console.WriteLine(showPrices
            ? $"{name} — {price:C}"
            : name);
    }

    if (!any)
        Console.WriteLine("По вашему запросу ничего не найдено.");
}

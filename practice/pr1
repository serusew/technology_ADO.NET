-- Задание 5

IF OBJECT_ID('college.GetStudentsByMinGrade', 'P') IS NOT NULL
    DROP PROCEDURE college.GetStudentsByMinGrade;
GO

CREATE PROCEDURE college.GetStudentsByMinGrade
    @min_grade DECIMAL(4,2)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        s.id,
        s.name,
        s.average_grade,
        g.name AS group_name
    FROM college.students AS s
    JOIN college.groups   AS g ON g.id = s.group_id
    WHERE s.average_grade >= @min_grade
    ORDER BY s.average_grade DESC;
END;
GO

EXEC college.GetStudentsByMinGrade @min_grade = 4.5;
GO

EXEC college.GetStudentsByMinGrade @min_grade = 4.0;
GO

-- Задание 6

IF OBJECT_ID('college.GetStudentStatus', 'FN') IS NOT NULL
    DROP FUNCTION college.GetStudentStatus;
GO

CREATE FUNCTION college.GetStudentStatus
(
    @average_grade DECIMAL(4,2)
)
RETURNS NVARCHAR(100)
AS
BEGIN
    DECLARE @status NVARCHAR(100);

    IF @average_grade >= 4.5
        SET @status = N'Отличник';
    ELSE IF @average_grade >= 3.5
        SET @status = N'Хорошист';
    ELSE
        SET @status = N'Требуется дополнительная подготовка';

    RETURN @status;
END;
GO

SELECT
    name,
    average_grade,
    college.GetStudentStatus(average_grade) AS status
FROM college.students;
GO

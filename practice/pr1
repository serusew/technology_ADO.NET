USE CollegeDB;
GO

-- Задание 1

SELECT
    s.name                          AS student_name,
    g.name                          AS group_name,
    s.average_grade                 AS average_grade,
    COUNT(gr.id)                    AS grades_count,
    AVG(CAST(gr.grade AS DECIMAL(4,2))) AS avg_grade_from_grades
FROM college.students AS s
JOIN college.groups   AS g  ON g.id = s.group_id
LEFT JOIN college.grades AS gr ON gr.student_id = s.id
GROUP BY s.name, g.name, s.average_grade
ORDER BY s.average_grade DESC;
GO

-- Задание 2

WITH StudentStats AS (
    SELECT
        id,
        name,
        group_id,
        average_grade
    FROM college.students
)
SELECT
    name,
    average_grade,
    RANK() OVER (ORDER BY average_grade DESC) AS rating
FROM StudentStats
ORDER BY rating;
GO

-- Задание 3

WITH StudentStats AS (
    SELECT
        s.id,
        s.name           AS student_name,
        g.name           AS group_name,
        s.average_grade
    FROM college.students AS s
    JOIN college.groups   AS g ON g.id = s.group_id
)
SELECT
    student_name,
    group_name,
    average_grade,
    RANK() OVER (
        PARTITION BY group_name
        ORDER BY average_grade DESC
    ) AS group_rating
FROM StudentStats
ORDER BY group_name, group_rating;
GO

-- Задание 4

IF OBJECT_ID('college.StudentRating', 'V') IS NOT NULL
    DROP VIEW college.StudentRating;
GO

CREATE VIEW college.StudentRating
AS
WITH StudentStats AS (
    SELECT
        s.id,
        s.name AS student_name,
        g.name AS group_name,
        s.average_grade
    FROM college.students AS s
    JOIN college.groups   AS g ON g.id = s.group_id
)
SELECT
    id,
    student_name     AS name,
    group_name,
    average_grade,
    RANK() OVER (
        PARTITION BY group_name
        ORDER BY average_grade DESC
    ) AS group_rating
FROM StudentStats;
GO


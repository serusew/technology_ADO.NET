{
    string sql = @"SELECT o.id, c.full_name, o.order_date, o.status
                   FROM orders o
                   JOIN customers c ON c.id = o.customer_id
                   ORDER BY o.order_date DESC";

    using SqlConnection connection = new SqlConnection(connectionString);

// 2

static async Task<int> GetProductCountAsync(string connectionString)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand("SELECT COUNT(*) FROM products", connection);
    return (int)(await command.ExecuteScalarAsync())!;
}

// 3
static async Task ShowProductsAsync(string connectionString, CancellationToken token = default)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync(token);

    using SqlCommand command = new SqlCommand(
        "SELECT id, name, price, is_available FROM products ORDER BY name;", connection);

    await using SqlDataReader reader = await command.ExecuteReaderAsync(token);

    bool hasRows = false;
    while (await reader.ReadAsync(token))
    {
        hasRows = true;
        int id = reader.GetInt32(0);
        string name = reader.GetString(1);
        decimal price = reader.GetDecimal(2);
        bool available = reader.GetBoolean(3);
        Console.WriteLine($"{id}. {name} – {price} руб. | {(available ? "Есть" : "Нет")}");
    }

    if (!hasRows)
        Console.WriteLine("Товары не найдены.");
}

// 4
static async Task ShowProductsFromPriceAsync(string connectionString, decimal minPrice)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand(
        "SELECT id, name, price FROM products WHERE price >= @min_price ORDER BY price;",
        connection);
    command.Parameters.AddWithValue("@min_price", minPrice);

    await using SqlDataReader reader = await command.ExecuteReaderAsync();

    bool found = false;
    while (await reader.ReadAsync())
    {
        found = true;
        Console.WriteLine($"{reader.GetInt32(0)}. {reader.GetString(1)} – {reader.GetDecimal(2)} руб.");
    }

    if (!found)
        Console.WriteLine($"Товаров с ценой не ниже {minPrice} руб. не найдено.");
}

// 5

static async Task UpdateProductAvailabilityAsync(
    string connectionString, int productId, bool isAvailable)
{
    await using SqlConnection connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using SqlCommand command = new SqlCommand(
        "UPDATE products SET is_available = @is_available WHERE id = @id;", connection);
    command.Parameters.AddWithValue("@is_available", isAvailable);
    command.Parameters.AddWithValue("@id", productId);

    int affected = await command.ExecuteNonQueryAsync();

    if (affected == 0)
        Console.WriteLine($"Товар с id={productId} не найден.");
    else
        Console.WriteLine($"Доступность товара {productId} изменена на " +
                          $"{(isAvailable ? "«Есть»" : "«Нет»")}.");
}

